{
  "name": "obsidian-vault-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local, single-vault Obsidian plugin for MCP-compatible clients.",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env dist/index.js",
    "tunnel:init": "node scripts/tunnel.mjs init",
    "tunnel:doctor": "node scripts/tunnel.mjs doctor",
    "remote": "node scripts/tunnel.mjs run",
    "test": "npm run build && tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
