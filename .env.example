# Set an existing Vault's absolute path locally. Do not commit the real path.
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/vault
OBSIDIAN_VAULT_ID=personal
# Optional JSON array of Vault-relative folders or files to exclude.
OBSIDIAN_EXCLUDED_PATHS='[]'
# Optional CLI executable and the Obsidian Vault name/ID for native graph capture.
# Defaults: obsidian on PATH, and the configured Vault folder name.
# OBSIDIAN_CLI_PATH=/usr/local/bin/obsidian
# OBSIDIAN_APP_VAULT=My Vault
