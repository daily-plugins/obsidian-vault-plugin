# Copy to .env.http (ignored). Generate the token with: openssl rand -hex 32
VAULT_HTTP_TOKEN=
VAULT_HTTP_HOST=127.0.0.1
VAULT_HTTP_PORT=3000
# Exact incoming Host header values, comma-separated (include non-default ports).
VAULT_HTTP_ALLOWED_HOSTS=127.0.0.1:3000,localhost:3000
# Requests without Origin are accepted. Requests with Origin require an exact match.
VAULT_HTTP_ALLOWED_ORIGINS=
